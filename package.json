{
  "name": "emenda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:desktop-e2e:frontend": "npm run typecheck && vite build --mode desktop-e2e",
    "build:desktop-e2e": "node e2e/build-desktop-e2e.mjs",
    "test:desktop-e2e": "npm run build:desktop-e2e && node e2e/run-desktop-e2e.mjs all",
    "test:desktop-e2e:notepad": "npm run build:desktop-e2e && node e2e/run-desktop-e2e.mjs notepad",
    "test:desktop-e2e:vscode": "npm run build:desktop-e2e && node e2e/run-desktop-e2e.mjs vscode",
    "check:production-exclusion": "node scripts/check-production-exclusion.mjs",
    "test:openrouter:live": "node scripts/run-strict-live-test.mjs openrouter",
    "test:desktop:native:notepad": "node scripts/run-strict-live-test.mjs notepad",
    "test:desktop:native:vscode": "node scripts/run-strict-live-test.mjs vscode",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "typescript": "~5.8.3",
    "vite": "^6.1.0"
  }
}
