{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Emenda Desktop E2E",
  "identifier": "ch.zbinden.emenda.desktop-e2e",
  "build": {
    "beforeBuildCommand": "npm run build:desktop-e2e:frontend",
    "frontendDist": "../dist-desktop-e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-e2e-main-capability",
          "description": "Test-only WebDriver access for the Emenda desktop E2E binary",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:default",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
